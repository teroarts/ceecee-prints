{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:setup && npm run build:vercel",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
